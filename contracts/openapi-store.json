{
  "openapi": "3.1.0",
  "info": {
    "title": "NestKart Store API",
    "description": "NestKart Playground Store API",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Liveness check",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthzResponse"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Readiness check",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyzResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/clock": {
      "get": {
        "tags": [
          "Clock"
        ],
        "summary": "Current store time",
        "operationId": "get_clock_api_v1_clock_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClockResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClockResponse": {
        "properties": {
          "now_utc": {
            "type": "string",
            "title": "Now Utc"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "now_utc",
          "mode"
        ],
        "title": "ClockResponse"
      },
      "HealthzResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthzResponse"
      },
      "ReadyzResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "title": "Database"
          },
          "clock": {
            "type": "string",
            "title": "Clock"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "clock"
        ],
        "title": "ReadyzResponse"
      }
    }
  }
}