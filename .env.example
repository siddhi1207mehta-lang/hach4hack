# NestKart Playground Environment Configuration
# All values are FAKE and safe for local development / testing

# Core Store API
DEMO_MODE=true
DATABASE_URL=sqlite:///data/store.db
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_ISSUER=nestkart-api
WEBHOOK_SECRET=fake_dev_webhook_secret_do_not_use_in_prod
AGENT_WEBHOOK_URL=http://localhost:8001/v1/webhooks/store
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SERVICE_CLIENT_SECRETS={"agent-executor":"fake_executor_secret_key_12345","agent-monitor":"fake_monitor_secret_key_67890"}
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152

# Web frontend feature flags
VITE_DEMO_MODE=true
VITE_ENABLE_STOREFRONT=false

